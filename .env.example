# Public build configuration only. Never place secrets in VITE_ variables.
# Enable only after public/videos/hero-headphones.mp4 exists and is verified.
VITE_HERO_VIDEO=false
# Browser test configuration (owned by playwright.config.ts).
TEST_BASE_URL=http://127.0.0.1:5178
# Optional development-only proxy, owned and validated by vite.config.ts.
DEV_API_TARGET=http://127.0.0.1:8081
