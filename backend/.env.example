# Opaque merchant accounts and isolated temporary browser workspaces.
# Runtime secret file contains runtime database/provider secrets. Migration file also
# contains VC_MIGRATION_DATABASE_URL. Never mount administrator credentials in API.
VC_SETTINGS_FILE=
VC_DATABASE_URL=postgresql://core_app:REPLACE_WITH_PRIVATE_PASSWORD@postgres:5432/vericommerce
VC_MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_PRIVATE_PASSWORD@postgres:5432/vericommerce
VC_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
VC_COOKIE_NAME=vc_demo
VC_COOKIE_SECURE=true
VC_SESSION_TTL_SECONDS=43200
VC_MAX_ACTIVE_SESSIONS=100
VC_MAX_BODY_BYTES=262144
VC_REQUESTS_PER_MINUTE=120
VC_SESSION_CREATIONS_PER_HOUR=20
VC_MAX_PRODUCTS=50
VC_MAX_SOURCES=100
VC_MAX_PASSAGES=500
VC_MAX_REVISIONS_PER_SOURCE=20
VC_MAX_DRAFTS=100
VC_MAX_JOBS=200
VC_MAX_AUDIT_EVENTS=1000
VC_AUDIT_PAGE_SIZE=50
VC_MAX_EVALUATIONS=20
VC_SEARCH_LIMIT=5
VC_MAX_SEARCH_LIMIT=10
VC_LEXICAL_MIN_SCORE=0.01
VC_RRF_CONSTANT=60
VC_DENSE_MIN_SIMILARITY=0.35
VC_DB_CONNECT_TIMEOUT_SECONDS=5
VC_DB_STATEMENT_TIMEOUT_MS=10000
VC_WORKER_POLL_SECONDS=1.0
VC_WORKER_LEASE_SECONDS=120
VC_WORKER_MAX_ATTEMPTS=3
VC_WORKER_RETRY_SECONDS=3
VC_WORKER_TENANT_BATCH=100
VC_WORKER_HEARTBEAT_PATH=.cache/worker.ready
VC_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
VC_EMBEDDING_ENABLED=false
VC_EMBEDDING_DOWNLOAD_ALLOWED=false
VC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VC_EMBEDDING_REPOSITORY=Qdrant/bge-small-en-v1.5-onnx-Q
VC_EMBEDDING_REVISION=aa8f8b060edb00e03bfdd08813a2949946c8ba55
VC_EMBEDDING_MODEL_FILE=model_optimized.onnx
VC_EMBEDDING_CACHE_DIR=.cache/models
VC_EMBEDDING_THREADS=1
VC_EMBEDDING_BATCH_SIZE=16
VC_SEED_PATH=data/demo.json
VC_POLICY_PATH=data/policy.json
VC_EVALUATION_PATH=data/heldout.json
VC_MIGRATIONS_PATH=migrations
VC_API_HOST=127.0.0.1
VC_API_PORT=8081
VC_API_VERSION=0.2.0
VC_REGISTRATION_ENABLED=true
VC_ACCOUNT_COOKIE_NAME=vc_account
VC_ACCOUNT_SESSION_TTL_SECONDS=43200
VC_ACCOUNT_ATTEMPTS_PER_HOUR=20
VC_ACCOUNT_MAX_TENANTS=10
VC_ACCOUNT_MAX_MEMBERS=50
VC_ACCOUNT_MAX_ACCOUNTS=1000
VC_ACCOUNT_MAX_SESSIONS=10
VC_PASSWORD_SCRYPT_N=131072
VC_PASSWORD_SCRYPT_R=8
VC_PASSWORD_SCRYPT_P=1
VC_PASSWORD_SCRYPT_MAXMEM=268435456
VC_PASSWORD_PARALLELISM=2
VC_PASSWORD_QUEUE_TIMEOUT_SECONDS=2.0
VC_UPLOAD_MAX_BYTES=1048576
VC_UPLOAD_MAX_STORAGE_BYTES=16777216
VC_UPLOAD_MAX_PIXELS=12000000
VC_UPLOAD_MAX_PAGES=40
VC_PARSER_TIMEOUT_SECONDS=10
VC_PARSER_MEMORY_BYTES=536870912
VC_PARSER_MAX_TEXT_CHARS=100000
VC_PARSER_MAX_RESULT_BYTES=4194304
VC_DOCUMENT_CHUNK_CHARS=4000
VC_CONTEXT_MAX_CHARS=12000
VC_CONTEXT_MAX_PASSAGES=10
VC_MAX_RELATIONS=1000
VC_INTELLIGENCE_POLICY_PATH=data/intelligence.json
VC_BENCHMARK_PATH=data/benchmark.json
VC_BENCHMARK_AGENT_REVIEW_PATH=data/benchmark-agent-review.json
VC_SHOPIFY_ENABLED=false
VC_SHOPIFY_CLIENT_ID=
VC_SHOPIFY_CLIENT_SECRET=
VC_SHOPIFY_ENCRYPTION_KEY=
VC_SHOPIFY_ORIGIN_TEMPLATE=https://{shop}
VC_SHOPIFY_REDIRECT_URI=
VC_SHOPIFY_RETURN_URL=
VC_SHOPIFY_OAUTH_COOKIE_NAME=vc_shopify_state
VC_SHOPIFY_API_VERSION=2026-10
VC_SHOPIFY_SCOPES=["read_products"]
VC_SHOPIFY_STATE_TTL_SECONDS=600
VC_SHOPIFY_CALLBACK_MAX_AGE_SECONDS=600
VC_SHOPIFY_CLOCK_SKEW_SECONDS=60
VC_SHOPIFY_TIMEOUT_SECONDS=10
VC_SHOPIFY_OPERATION_TIMEOUT_SECONDS=30
VC_SHOPIFY_MAX_PAGES=20
VC_SHOPIFY_PAGE_SIZE=25
VC_SHOPIFY_MAX_RETRIES=3
VC_SHOPIFY_RETRY_SECONDS=1
VC_SHOPIFY_MAX_RETRY_SECONDS=5
VC_SHOPIFY_MAX_RESPONSE_BYTES=2097152
VC_SHOPIFY_WEBHOOK_MAX_BYTES=1048576
VC_SHOPIFY_WEBHOOK_MAX_AGE_SECONDS=172800
VC_SHOPIFY_RECEIPT_RETENTION_DAYS=30
VC_SHOPIFY_MAX_RECEIPTS=10000
VC_SHOPIFY_MAX_SYNCS=100
VC_SHOPIFY_REFRESH_MARGIN_SECONDS=60
VC_SHOPIFY_QUERY_PATH=data/shopify_graphql.json
