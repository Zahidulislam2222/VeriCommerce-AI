# Temporary isolated browser workspaces; merchant account authentication is not configured.
# Runtime secret file contains VC_DATABASE_URL only. Migration secret file also
# contains VC_MIGRATION_DATABASE_URL. Never mount administrator credentials in API.
VC_SETTINGS_FILE=
VC_DATABASE_URL=postgresql://core_app:REPLACE_WITH_PRIVATE_PASSWORD@postgres:5432/vericommerce
VC_MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE_WITH_PRIVATE_PASSWORD@postgres:5432/vericommerce
VC_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
VC_COOKIE_NAME=vc_demo
VC_COOKIE_SECURE=true
VC_SESSION_TTL_SECONDS=43200
VC_MAX_ACTIVE_SESSIONS=100
VC_MAX_BODY_BYTES=262144
VC_REQUESTS_PER_MINUTE=120
VC_SESSION_CREATIONS_PER_HOUR=20
VC_MAX_PRODUCTS=50
VC_MAX_SOURCES=100
VC_MAX_PASSAGES=500
VC_MAX_REVISIONS_PER_SOURCE=20
VC_MAX_DRAFTS=100
VC_MAX_JOBS=200
VC_MAX_AUDIT_EVENTS=1000
VC_MAX_EVALUATIONS=20
VC_SEARCH_LIMIT=5
VC_MAX_SEARCH_LIMIT=10
VC_LEXICAL_MIN_SCORE=0.01
VC_RRF_CONSTANT=60
VC_DENSE_MIN_SIMILARITY=0.35
VC_DB_CONNECT_TIMEOUT_SECONDS=5
VC_DB_STATEMENT_TIMEOUT_MS=10000
VC_WORKER_POLL_SECONDS=1.0
VC_WORKER_LEASE_SECONDS=120
VC_WORKER_MAX_ATTEMPTS=3
VC_WORKER_RETRY_SECONDS=3
VC_WORKER_TENANT_BATCH=100
VC_WORKER_HEARTBEAT_PATH=.cache/worker.ready
VC_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
VC_EMBEDDING_ENABLED=false
VC_EMBEDDING_DOWNLOAD_ALLOWED=false
VC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VC_EMBEDDING_REPOSITORY=Qdrant/bge-small-en-v1.5-onnx-Q
VC_EMBEDDING_REVISION=aa8f8b060edb00e03bfdd08813a2949946c8ba55
VC_EMBEDDING_MODEL_FILE=model_optimized.onnx
VC_EMBEDDING_CACHE_DIR=.cache/models
VC_EMBEDDING_THREADS=1
VC_EMBEDDING_BATCH_SIZE=16
VC_SEED_PATH=data/demo.json
VC_POLICY_PATH=data/policy.json
VC_EVALUATION_PATH=data/heldout.json
VC_MIGRATIONS_PATH=migrations
VC_API_HOST=127.0.0.1
VC_API_PORT=8081
VC_API_VERSION=0.2.0
