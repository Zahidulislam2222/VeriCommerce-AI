{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core deployment operator configuration (no credentials)",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "loopback_port", "web_port", "api_port", "network_subnet", "network_ip_range", "postgres_image", "nginx_image", "python_image", "db_name", "db_admin_user", "db_runtime_user", "postgres_service", "postgres_port", "expected_static_release", "backend_directory", "environment", "app_memory", "app_cpus", "db_memory", "db_cpus", "command_timeout", "compose_wait_seconds", "max_body_bytes", "proxy_connect_seconds", "proxy_read_seconds", "container_backup_directory", "sftp_prefetch_requests", "captured_stdout_bytes"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,47}$"},
    "loopback_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "web_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "api_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "network_subnet": {"type": "string"},
    "network_ip_range": {"type": "string"},
    "postgres_image": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
    "nginx_image": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
    "python_image": {"type": "string", "pattern": "@sha256:[a-f0-9]{64}$"},
    "db_name": {"type": "string"},
    "db_admin_user": {"type": "string"},
    "db_runtime_user": {"type": "string"},
    "postgres_service": {"type": "string"},
    "postgres_port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "expected_static_release": {"type": "string"},
    "backend_directory": {"type": "string"},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "app_memory": {"type": "string"},
    "app_cpus": {"type": "string"},
    "db_memory": {"type": "string"},
    "db_cpus": {"type": "string"},
    "command_timeout": {"type": "integer", "minimum": 1},
    "compose_wait_seconds": {"type": "integer", "minimum": 1},
    "max_body_bytes": {"type": "integer", "minimum": 1},
    "proxy_connect_seconds": {"type": "integer", "minimum": 1},
    "proxy_read_seconds": {"type": "integer", "minimum": 1},
    "container_backup_directory": {"type": "string"},
    "sftp_prefetch_requests": {"type": "integer", "minimum": 1, "maximum": 64},
    "captured_stdout_bytes": {"type": "integer", "minimum": 1}
  }
}
